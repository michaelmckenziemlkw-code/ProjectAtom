{
  "name": "projectatom",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:unit": "node --test src/core/*.test.ts",
    "test": "playwright test",
    "format": "prettier --write src tests/browser *.ts index.html package.json tsconfig.json"
  },
  "dependencies": {
    "@babylonjs/core": "9.35.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^24.0.0",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  }
}
